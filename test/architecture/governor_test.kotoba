(ns architecture.governor-test
  (:require [clojure.test :refer [deftest is testing]]
            [architecture.store :as store]
            [architecture.governor :as governor]
            [architecture.operations :as operations]))

(defn- fresh-store []
  (let [st (store/mem-store)]
    (store/register-project! st {:project-id "proj-1" :client-id "client-1" :name "Community Garden"})
    st))

(deftest ok-on-clean-design-concept
  (let [st (fresh-store)
        proposal {:op :draft-design-concept :effect :propose :confidence 0.9 :stake :low}
        v (governor/check {:project-id "proj-1"} {} proposal st)]
    (is (:ok? v))
    (is (not (:hard? v)))
    (is (not (:escalate? v)))))

(deftest hard-on-unregistered-project
  (let [st (fresh-store)
        proposal {:op :draft-design-concept :effect :propose :confidence 0.9 :stake :low}
        v (governor/check {:project-id "no-such-project"} {} proposal st)]
    (is (:hard? v))
    (is (some #(= :no-project (:rule %)) (:violations v)))))

(deftest hard-on-no-actuation-violation
  (let [st (fresh-store)
        proposal {:op :draft-design-concept :effect :direct-write :confidence 0.9 :stake :low}
        v (governor/check {:project-id "proj-1"} {} proposal st)]
    (is (:hard? v))
    (is (some #(= :no-actuation (:rule %)) (:violations v)))))

(deftest hard-on-attempt-to-issue-stamped-design
  (let [st (fresh-store)
        proposal {:op :issue-stamped-design :effect :propose :confidence 0.9 :stake :high}
        v (governor/check {:project-id "proj-1"} {} proposal st)]
    (is (:hard? v))
    (is (some #(= :no-stamping (:rule %)) (:violations v)))))

(deftest hard-on-attempt-to-certify-compliance
  (let [st (fresh-store)
        proposal {:op :certify-environmental-compliance :effect :propose :confidence 0.9 :stake :high}
        v (governor/check {:project-id "proj-1"} {} proposal st)]
    (is (:hard? v))
    (is (some #(= :no-stamping (:rule %)) (:violations v)))))

(deftest escalates-on-environmental-flag
  (let [st (fresh-store)
        proposal {:op :flag-environmental-compliance-issue :effect :propose :confidence 0.9 :stake :high}
        v (governor/check {:project-id "proj-1"} {} proposal st)]
    (is (:escalate? v))
    (is (not (:hard? v)))))

(deftest escalates-on-environmental-system
  (let [st (fresh-store)
        proposal {:op :draft-design-concept :effect :propose :confidence 0.9 :stake :medium
                  :scope :drainage :tags #{:drainage :stormwater}}
        v (governor/check {:project-id "proj-1"} {} proposal st)]
    (is (:escalate? v))
    (is (not (:hard? v)))))

(deftest escalates-on-low-confidence
  (let [st (fresh-store)
        proposal {:op :prepare-specification :effect :propose :confidence 0.2 :stake :low}
        v (governor/check {:project-id "proj-1"} {} proposal st)]
    (is (:escalate? v))
    (is (not (:hard? v)))))

(deftest store-records-and-ledger-append-only
  (let [st (fresh-store)]
    (store/commit-record! st {:project-id "proj-1" :op :prepare-specification})
    (store/append-ledger! st {:disposition :commit})
    (is (= 1 (count (store/records-of st "proj-1"))))
    (is (= 1 (count (store/ledger st))))))

(deftest hard-on-op-outside-the-catalog
  ;; A registered project, :propose effect, high confidence, no environmental
  ;; tags: every rule the governor had before the catalog is satisfied, and
  ;; this verdict was {:ok? true}.
  (let [st (fresh-store)
        proposal {:op :demolish-site :effect :propose :confidence 0.9 :stake :low}
        v (governor/check {:project-id "proj-1"} {} proposal st)]
    (is (:hard? v))
    (is (not (:ok? v)))
    (is (not (:escalate? v)))
    (is (= [:unknown-op] (mapv :rule (:violations v))))))

(deftest hard-on-unreadable-llm-reply
  ;; advisor/parse-proposal's fallback. Escalating it would ask a human to
  ;; approve a record whose :op is :unknown.
  (let [st (fresh-store)
        proposal {:op :unknown :effect :propose :confidence 0.0 :stake :high
                  :rationale "LLM response parse failure"}
        v (governor/check {:project-id "proj-1"} {} proposal st)]
    (is (:hard? v))
    (is (not (:escalate? v)))
    (is (some #(= :unknown-op (:rule %)) (:violations v)))))

(deftest every-permitted-op-passes-the-hard-rules
  ;; The catalog and the governor must agree: an op the catalog permits is
  ;; never hard-blocked for being unknown.
  (let [st (fresh-store)]
    (doseq [op (keys operations/permitted)]
      (let [v (governor/check {:project-id "proj-1"} {}
                              {:op op :effect :propose :confidence 0.9 :stake :low} st)]
        (is (not (:hard? v)) (str op " was hard-blocked"))))))

(deftest forbidden-ops-are-not-reported-as-unknown
  ;; The seal ops are refused for the reason they exist, not as typos.
  (let [st (fresh-store)]
    (doseq [op operations/forbidden]
      (let [v (governor/check {:project-id "proj-1"} {}
                              {:op op :effect :propose :confidence 0.9 :stake :high} st)]
        (is (= [:no-stamping] (mapv :rule (:violations v))) (str op))))))

(deftest catalog-is-the-advisors-documented-vocabulary
  ;; architecture.advisor's docstring names these four ops. An op dropped from
  ;; the catalog would otherwise just start holding, and nothing above fails.
  (is (= #{:draft-design-concept :prepare-specification
           :flag-environmental-compliance-issue :request-client-review}
         (set (keys operations/permitted)))))
